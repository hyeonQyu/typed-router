{
  "name": "typed-router",
  "version": "2.3.1",
  "author": "hyeonQyu <dhk0561@naver.com>",
  "license": "MIT",
  "packageManager": "yarn@4.11.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hyeonQyu/typed-router.git"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"packages/**/src/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"packages/**/src/**/*.{ts,tsx,json,md}\"",
    "type": "turbo run type",
    "bump": "node scripts/version.js",
    "publish": "node scripts/publish.js",
    "core": "yarn workspace @hyeonqyu/typed-router-core",
    "react": "yarn workspace @hyeonqyu/typed-router-react",
    "next": "yarn workspace @hyeonqyu/typed-router-next",
    "test": "tsc -p tests/tsconfig.json --noEmit && vitest run"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "tsup": "^8.5.1",
    "turbo": "^2.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
