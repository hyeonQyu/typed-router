{
  "name": "@hyeonqyu/typed-router-next",
  "version": "2.2.0",
  "description": "Type-safe routing for Next.js App Router and Pages Router: one route tree, typed pathnames, params and search params",
  "author": "hyeonQyu <dhk0561@naver.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hyeonQyu/typed-router.git"
  },
  "homepage": "https://github.com/hyeonQyu/typed-router#readme",
  "bugs": {
    "url": "https://github.com/hyeonQyu/typed-router/issues"
  },
  "keywords": [
    "react",
    "next",
    "nextjs",
    "routing",
    "typescript",
    "type-safe",
    "information-architecture"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./pages": {
      "types": "./dist/pages.d.ts",
      "import": "./dist/pages.mjs",
      "require": "./dist/pages.js"
    },
    "./check": {
      "types": "./dist/check.d.ts",
      "import": "./dist/check.mjs",
      "require": "./dist/check.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "type": "tsc --noEmit"
  },
  "peerDependencies": {
    "next": "^13.0.0 || ^14.0.0 || ^15.0.0 || ^16.0.0",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "zod": "^3.24.0 || ^4.0.0"
  },
  "dependencies": {
    "@hyeonqyu/typed-router-core": "^2.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "next": "^15.1.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  }
}
