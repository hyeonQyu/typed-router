{
  "name": "@hyeonqyu/typed-router-core",
  "version": "2.3.0",
  "description": "Framework-agnostic core for typed-router: declare your route tree once, derive pathnames, params and search-param types from it",
  "author": "hyeonQyu <dhk0561@naver.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hyeonQyu/typed-router.git"
  },
  "homepage": "https://github.com/hyeonQyu/typed-router#readme",
  "bugs": {
    "url": "https://github.com/hyeonQyu/typed-router/issues"
  },
  "keywords": [
    "react",
    "routing",
    "typescript",
    "type-safe",
    "information-architecture"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "type": "tsc --noEmit"
  },
  "peerDependencies": {
    "zod": "^3.24.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "zod": "^3.24.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
